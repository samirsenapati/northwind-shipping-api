# Port the API listens on
PORT=3000

# API keys this instance accepts. Test keys start nw_test_ and buy free, unshippable labels;
# live keys start nw_live_. Leave NORTHWIND_LIVE_KEY empty to run in test mode only.
NORTHWIND_TEST_KEY=nw_test_localdevelopment01
NORTHWIND_LIVE_KEY=

# Requests per minute per API key. Keys on the Scale plan get SCALE_RATE_LIMIT_PER_MINUTE.
RATE_LIMIT_PER_MINUTE=600
SCALE_RATE_LIMIT_PER_MINUTE=1200

# Days after fulfilment during which customers can start a return
RETURN_WINDOW_DAYS=30

# How long failed webhook deliveries keep being retried
WEBHOOK_MAX_RETRY_HOURS=72
